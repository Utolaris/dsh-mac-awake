{
  "name": "dsh-mac-stay-awake-local",
  "version": "1.1.0",
  "private": true,
  "os": ["darwin"],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "description": "Prevent macOS idle sleep while DSH Desktop is running, except during configured time periods.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": ["darwin"]
    }
  }
}
